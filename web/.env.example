# Address printed by contracts/script/Deploy.s.sol
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: Pinata JWT for receipt uploads. Use a key scoped to pinFileToIPFS only —
# it is visible in the browser. Move uploads behind a small backend before scaling.
VITE_PINATA_JWT=
# Optional: point at a local Celo fork (anvil --fork-url https://forno.celo.org)
VITE_RPC_URL=
